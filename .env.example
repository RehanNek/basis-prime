# Copy to .env and fill in. .env is gitignored: keys never go in the repo.
# To save a value without it showing on screen: bash scripts/set-env.sh NAME
# Every variable is listed here with no value. Where a value is public, the comment says where it comes from.

# ---------- Networks ----------
NEAR_NETWORK=                 # testnet | mainnet
NEAR_RPC_URL=                 # testnet: https://test.rpc.fastnear.com (research/near.md 8)
HL_API_URL=                   # testnet: https://api.hyperliquid-testnet.xyz (research/hyperliquid.md 5)
OUTLAYER_API_URL=             # testnet: https://testnet-api.outlayer.ai (research/outlayer.md 3)
ONECLICK_API_URL=             # https://1click.chaindefuser.com (research/intents.md)

# ---------- Our NEAR accounts (testnet ones are created by hand in Phase 0; keys also stay in the Mac's keychain) ----------
# Save a key without showing it:
#   near account export-account <account> using-private-key network-config testnet | bash scripts/set-env.sh <NAME>
FACTORY_ACCOUNT_ID=           # client accounts are <name>.<factory>
POOL_ACCOUNT_ID=              # pool.<factory>
OPERATOR_ACCOUNT_ID=          # funds the pool, sets KYB flags, co-signs, can pause
OPERATOR_PRIVATE_KEY=
COSIGNER_ACCOUNT_ID=          # co-signs large actions (RISK_ENGINE.md 12.2): the operator on testnet, a multisig on mainnet
COSIGNER_PRIVATE_KEY=         # testnet: leave empty, the operator's key signs
KEEPER_ACCOUNT_ID=            # pays for checks; uses public methods only; owns the OutLayer payment key
KEEPER_PRIVATE_KEY=

# ---------- Testnet tokens and the 1Click shim (Phase 1) ----------
MUSDC_TOKEN_ID=               # testnet: musdc.pbf-ops.testnet (mUSDC, 6 decimals, public faucet)
MNBTC_TOKEN_ID=               # testnet: mnbtc.pbf-ops.testnet (mNBTC, 8 decimals, public faucet)
DRILL_ACCOUNT_ID=             # testnet: drill.pbf-ops.testnet (the nBTC/BTC ratio for the depeg drill)
SHIM_URL=                     # where the 1Click shim listens, e.g. http://localhost:8787
SHIM_NEAR_ACCOUNT_ID=         # the shim's NEAR testnet float: takes deposits, delivers mUSDC and mNBTC
SHIM_NEAR_PRIVATE_KEY=
SHIM_ADMIN_TOKEN=             # guards the shim's fault switch; any long random string

# ---------- Keeper (Phase 4) ----------
KEEPER_LOG_FILE=              # the keeper's JSON-lines log; default services/keeper/logs/keeper.jsonl. The backend reads it for the Risk page
KEEPER_PORT=                  # the keeper's status page on localhost; default 8789
BOOK_STRESS_LOG_FILE=         # Phase 5: the daily book stress test's results; default services/keeper/logs/book-stress.jsonl. The keeper writes it, the backend reads it

# ---------- Privacy level 1 (INTERFACES.md 48): who the backend shows a client account to ----------
ACCOUNT_PRIVACY=              # owner (the default when empty): an account shows only to its owner's wallet, the operator's and the keeper's. off: to anyone, as before 13 Nov. Anything else stops the backend
OPEN_ACCOUNTS=                # client accounts anyone may look at (demo accounts), separated by commas, each <name>.<factory>. Not secret. Default: none
SERVICE_TOKEN_FILE=           # where the backend writes the token our own services send (the keeper, the gate scripts); default services/api/logs/service-token, readable by this user only. The keeper package reads the same setting

# ---------- Phase 5: mainnet reads and the activity index (read-only; nothing is signed or paid on mainnet) ----------
MAINNET_NEAR_RPC_URL=         # Rhea's terms (GET /api/rhea); default https://free.rpc.fastnear.com
HL_MAINNET_API_URL=           # the credit check's worked example reads today's BTC price here; default https://api.hyperliquid.xyz
FASTNEAR_TX_URL=              # the account history (GET /api/activity); default https://tx.test.fastnear.com (docs.fastnear.com/tx)
FASTNEAR_API_KEY=             # optional: FastNEAR answers without one; with one it goes as a bearer token, server-side only

# ---------- Phase 6: funding from lenders (FUNDING.md; INTERFACES.md 24). Stage 1 only reads these chains ----------
# Stage 4 (INTERFACES.md 36) adds no setting. The 1Click shim now reads six of these too: EVM_RPC_URL, EVM_CHAIN_ID,
# EVM_GAS_PRIVATE_KEY (its float on Base Sepolia), AAVE_FAUCET_ADDRESS, AAVE_DATA_PROVIDER_ADDRESS (Aave's supply caps)
# and FACTORY_ACCOUNT_ID (it takes the test tokens' addresses from the factory's Aave settings when it starts).
EVM_RPC_URL=                # the chain Aave's test market is on; default https://sepolia.base.org (Base Sepolia, public, rate-limited)
EVM_CHAIN_ID=                 # default 84532 (Base Sepolia). The backend refuses an RPC that answers for another chain
AAVE_POOL_ADDRESS=            # default 0x8bAB6d1b75f19e9eD9fCe8b9BD338844fF79aE27 (AaveV3BaseSepolia.sol in bgd-labs/aave-address-book)
AAVE_DATA_PROVIDER_ADDRESS=   # default 0xBc9f5b7E248451CdD7cA54e717a2BFe1F32b566b (the same file); GET /api/lenders reads the test market's terms from it
AAVE_FAUCET_ADDRESS=          # default 0xD9145b5F45Ad4519c7ACcD6E0A4A82e83bB8A6Dc (Aave's interface repository; research/aave.md): mints test WBTC and USDC
EVM_GAS_ADDRESS=              # stage 3: the gas wallet's address, made with: python3 -I scripts/new-hl-float.py --gas. Send it test ETH from a Base Sepolia faucet
EVM_GAS_PRIVATE_KEY=          # stage 3: a test-chain key that pays gas for the accounts' signed Ethereum transactions; server-side only. Leave empty until then. Stage 4: the same wallet is the shim's float on Base Sepolia (it delivers test WBTC, WETH and USDC from it, and wraps its test ETH for WETH). Empty: the shim refuses a committed quote to or from Base Sepolia
RHEA_ACCOUNT_ID=              # stage 2: our Rhea copy on testnet (rhea.pbf-ops.testnet). Empty: GET /api/lenders has no testnet Rhea row. The keeper keeps its BTC price in step with Hyperliquid's oracle, signing as the copy's owner with OPERATOR_PRIVATE_KEY
OUTLAYER_WAIT_MS=             # how long one OutLayer run may take, its wait in OutLayer's queue included, in ms. Default 180000 (3 minutes); 10000 to 600000. Read by the backend, the keeper and the gate scripts
RHEA_PRICE_HOLD_FILE=         # stage 2: the file that puts our Rhea copy's BTC price on hold for the gate's price drop; default services/keeper/logs/rhea-price-hold.json. The keeper and funding:demo must read the same one
MNBTC_TOKEN_ID=               # stage 2: the test nBTC token whose price the keeper sets on our Rhea copy (mnbtc.pbf-ops.testnet)

# ---------- Backend and web app (Phase 2) ----------
# The backend (services/api) reads the ids above and the keys below; it never sends a key to the browser.
API_URL=                      # where the backend listens, e.g. http://localhost:8788 (the default); the web app proxies /api to it
# The web app gets only NEXT_PUBLIC_* values, which are public by design: put ids here, never keys.
# Each defaults to its testnet id in INTERFACES.md 1, so these only need values if an id changes.
NEXT_PUBLIC_NEAR_NETWORK=     # testnet
NEXT_PUBLIC_FACTORY_ACCOUNT_ID=  # testnet: pbf.testnet
NEXT_PUBLIC_POOL_ACCOUNT_ID=  # testnet: pool.pbf.testnet
NEXT_PUBLIC_MUSDC_TOKEN_ID=   # testnet: musdc.pbf-ops.testnet
NEXT_PUBLIC_MNBTC_TOKEN_ID=   # testnet: mnbtc.pbf-ops.testnet

# ---------- Keys you create (PLAN.md 12) ----------
ONECLICK_JWT=                 # 1Click partner key, partners.near-intents.org; server-side only
OUTLAYER_PAYMENT_KEY=         # owner:nonce:secret, made with the OutLayer CLI as the keeper; server-side only
PYTH_HERMES_KEY=              # optional: without it the engine prices from five sources, not six
AURORA_INTENTS_KEY=           # optional, only if we get ahead
RESEND_API_KEY=               # optional, only if we get ahead (email alerts are cut for now)

# ---------- Hyperliquid testnet float (funded from a teammate's faucet claim) ----------
HL_FLOAT_ADDRESS=
HL_FLOAT_PRIVATE_KEY=         # testnet only: sends test USDC to derived addresses, and can post resting orders
